---
import Base from '../../layouts/Base.astro';
import PostEntries from '../../components/PostEntries.astro';
import { loadPosts, inCategory } from '../../lib/posts';

const posts = inCategory(await loadPosts(), '读书');
---
<Base title="读书" description="原田莓莓的读书笔记。">
  <header class="page-head">
    <h1>读书</h1>
    <p>{posts.length} 篇读书笔记，大多是技术书，也有几本经史。</p>
  </header>
  <section class="section">
    <ul class="entry-list">
      <PostEntries posts={posts} />
    </ul>
  </section>
</Base>
