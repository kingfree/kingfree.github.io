---
import 'katex/dist/katex.min.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-regular.css';
import 'lxgw-wenkai-webfont/lxgwwenkai-bold.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: string;
  wide?: boolean;
}

const { title, description = '原田莓莓的个人站：Kigurumi、代码与读书。', type = 'website', wide = false } = Astro.props;
const site = 'meimoe.fun';
const pageTitle = title ? title + ' · 原田莓莓' : '原田莓莓 · Meimei';
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: '/posts/', label: '文章' },
  { href: '/repost/', label: '转载' },
  { href: '/reading/', label: '读书' },
  { href: '/photos/', label: '写真' },
  { href: '/about/', label: '关于' },
];
const current = (p: string) => Astro.url.pathname === p || Astro.url.pathname.startsWith(p);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="alternate" type="application/rss+xml" title="原田莓莓" href="/rss.xml" />
    <meta name="theme-color" content="#fbf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110f" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (() => {
        try {
          const forced = new URLSearchParams(location.search).get('theme');
          const saved = forced || localStorage.getItem('theme');
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/">原田莓莓<span>meimoe.fun</span></a>
        <nav class="nav">
          {nav.map((item) => (
            <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="nav-search" id="search-open" type="button" title="搜索（/）" aria-label="搜索" aria-haspopup="dialog" aria-controls="search-modal">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
              <circle cx="10.5" cy="10.5" r="6.4"></circle>
              <path d="m15.4 15.4 5 5"></path>
            </svg>
          </button>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深色模式">◐</button>
        </nav>
      </div>
    </header>
    <main class={wide ? 'wrap wrap-wide' : 'wrap'}>
      <slot />
    </main>
    <footer class="site-footer wrap">
      <span>© {new Date().getFullYear()} 原田莓莓</span>
      <span class="sep">/</span>
      <a href="https://github.com/kingfree" rel="me noopener">GitHub</a>
      <span class="sep">/</span>
      <a href="https://x.com/meimeikaze" rel="me noopener">X</a>
      <span class="sep">/</span>
      <a href="https://www.pixiv.net/users/5066858" rel="me noopener">Pixiv</a>
      <span class="sep">/</span>
      <a href="https://meis.moe" rel="noopener">莓萌®</a>
      <span class="sep">/</span>
      <a href="https://pinhaotou.cn" rel="noopener">拼好头™</a>
      <span class="sep">/</span>
      <a href="/archives/">归档</a>
      <span class="sep">/</span>
      <a href="/tags/">标签</a>
      <span class="sep">/</span>
      <a href="/rss.xml">RSS</a>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
    <div class="search-modal" id="search-modal" hidden>
      <div class="search-panel" role="dialog" aria-modal="true" aria-labelledby="search-label">
        <div class="search-row">
          <svg class="search-glyph" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
            <circle cx="10.5" cy="10.5" r="6.4"></circle>
            <path d="m15.4 15.4 5 5"></path>
          </svg>
          <input
            class="search-input"
            id="search-input"
            type="search"
            placeholder="搜索文章、标签、写真角色…"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-label="搜索关键词"
            aria-controls="search-results"
          />
          <button class="search-close" id="search-close" type="button" aria-label="关闭搜索">esc</button>
        </div>
        <p class="search-status" id="search-status" role="status" aria-live="polite"></p>
        <div class="search-results" id="search-results"></div>
        <div class="search-idle" id="search-idle">
          <p class="search-hint" id="search-label">标题、正文、标签、角色名都能搜；输入年份会给出当年的写真。</p>
          <ul class="search-chips" id="search-chips"></ul>
          <p class="search-keys"><kbd>↑</kbd> <kbd>↓</kbd> 选择 · <kbd>↵</kbd> 打开 · <kbd>esc</kbd> 关闭</p>
        </div>
      </div>
    </div>    <script is:inline>
      // 站内搜索浮窗：点导航栏的放大镜、按 / 或 Cmd/Ctrl+K 打开
      (() => {
        const modal = document.getElementById('search-modal');
        const panel = modal && modal.querySelector('.search-panel');
        const opener = document.getElementById('search-open');
        const input = document.getElementById('search-input');
        const closeBtn = document.getElementById('search-close');
        const status = document.getElementById('search-status');
        const idle = document.getElementById('search-idle');
        const chipsBox = document.getElementById('search-chips');
        const list = document.getElementById('search-results');
        if (!modal || !input || !list) return;

        const ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\u0022': '&quot;', '\u0027': '&#39;' };
        const esc = (v) => String(v == null ? '' : v).replace(/[&<>\u0022\u0027]/g, (ch) => ESC[ch]);
        const lower = (v) => String(v == null ? '' : v).toLowerCase();
        const normalize = (v) => lower(v).replace(/\s+/g, ' ').trim();
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

        let index = null;
        let loading = false;
        let active = -1;
        let timer = 0;
        let lastFocus = null;
        let closeTimer = 0;

        function loadIndex() {
          if (index || loading) return;
          loading = true;
          fetch('/search-index.json', { credentials: 'omit' })
            .then((res) => {
              if (!res.ok) throw new Error('HTTP ' + res.status);
              return res.json();
            })
            .then((data) => {
              index = {
                posts: (data.posts || []).map((p) => ({
                  s: p.s,
                  t: p.t,
                  d: p.d,
                  c: p.c,
                  g: p.g || [],
                  x: p.x || '',
                  lt: lower(p.t),
                  lg: lower((p.g || []).join(' ')),
                  lh: lower((p.h || []).join(' ')),
                  lx: lower(p.x),
                })),
                chars: (data.chars || []).map((c) => ({
                  n: c.n,
                  k: c.k,
                  c: c.c,
                  y: c.y,
                  w: c.w,
                  b: c.b,
                  ln: lower(c.n),
                  lk: lower(c.k),
                  lw: lower(c.w),
                })),
                years: data.years || [],
              };
              loading = false;
              if (chipsBox && !chipsBox.children.length) {
                chipsBox.innerHTML = index.chars
                  .slice(0, 10)
                  .map(
                    (c) =>
                      '<li><button type="button" class="chip" data-q="' + esc(c.n) + '">' + esc(c.n) +
                      '<span class="n">' + c.c + '</span></button></li>',
                  )
                  .join('');
              }
              run();
            })
            .catch(() => {
              loading = false;
              status.textContent = '搜索索引没载入成功，刷新一下再试。';
            });
        }

        function scorePost(p, tokens) {
          let total = 0;
          for (const tk of tokens) {
            let s = 0;
            const ti = p.lt.indexOf(tk);
            if (ti >= 0) s += 1000 - Math.min(ti, 400);
            if (p.lg.indexOf(tk) >= 0) s += 400;
            if (p.lh.indexOf(tk) >= 0) s += 120;
            const xi = p.lx.indexOf(tk);
            if (xi >= 0) s += 40 + Math.max(0, 40 - xi / 600);
            if (!s) return 0;
            total += s;
          }
          return total;
        }

        function scoreChar(c, tokens) {
          let total = 0;
          for (const tk of tokens) {
            let s = 0;
            if (c.ln.indexOf(tk) >= 0) s += 1000;
            if (c.lk.indexOf(tk) >= 0) s += 800;
            if (c.lw.indexOf(tk) >= 0) s += 200;
            if (!s) return 0;
            total += s;
          }
          return total;
        }

        function search(q) {
          const tokens = normalize(q).split(' ').filter(Boolean);
          const out = { tokens, posts: [], chars: [], years: [] };
          if (!tokens.length || !index) return out;
          for (const p of index.posts) {
            const s = scorePost(p, tokens);
            if (s) out.posts.push({ p, score: s });
          }
          out.posts.sort((a, b) => b.score - a.score || (a.p.d < b.p.d ? 1 : -1));
          for (const c of index.chars) {
            const s = scoreChar(c, tokens);
            if (s) out.chars.push({ c, score: s });
          }
          out.chars.sort((a, b) => b.score - a.score || b.c.c - a.c.c);
          if (tokens.length === 1) {
            const hit = index.years.find((y) => y.y === tokens[0]);
            if (hit) out.years.push(hit);
          }
          return out;
        }

        // 把命中的词包上 <mark>：纯文本定位，不碰正则
        function highlight(text, tokens) {
          if (!text) return '';
          const low = lower(text);
          const marks = [];
          for (const tk of tokens) {
            let from = 0;
            for (;;) {
              const at = low.indexOf(tk, from);
              if (at < 0) break;
              marks.push([at, at + tk.length]);
              from = at + tk.length;
              if (marks.length > 300) break;
            }
          }
          if (!marks.length) return esc(text);
          marks.sort((a, b) => a[0] - b[0]);
          const merged = [];
          for (const m of marks) {
            const last = merged[merged.length - 1];
            if (last && m[0] <= last[1]) last[1] = Math.max(last[1], m[1]);
            else merged.push([m[0], m[1]]);
          }
          let out = '';
          let pos = 0;
          for (const m of merged) {
            out += esc(text.slice(pos, m[0])) + '<mark>' + esc(text.slice(m[0], m[1])) + '</mark>';
            pos = m[1];
          }
          return out + esc(text.slice(pos));
        }

        function snippet(text, tokens) {
          if (!text) return '';
          const low = lower(text);
          let at = -1;
          for (const tk of tokens) {
            const i = low.indexOf(tk);
            if (i >= 0 && (at < 0 || i < at)) at = i;
          }
          if (at < 0) {
            const head = text.slice(0, 96).trim();
            return head + (text.length > 96 ? '…' : '');
          }
          const start = Math.max(0, at - 30);
          const end = Math.min(text.length, at + 90);
          const body = text.slice(start, end).trim();
          return (start > 0 ? '…' : '') + body + (end < text.length ? '…' : '');
        }

        function render(result) {
          active = -1;
          const total = result.posts.length + result.chars.length + result.years.length;
          if (!total) {
            list.hidden = true;
            list.innerHTML = '';
            idle.hidden = true;
            status.textContent = '没有找到「' + input.value.trim() + '」';
            return;
          }
          idle.hidden = true;
          const html = [];

          const group = (label, rows) => {
            if (!rows.length) return;
            html.push('<h2 class="sr-group">' + label + '<span>' + rows.length + '</span></h2>');
            html.push('<ol class="sr-list">' + rows.join('') + '</ol>');
          };

          group(
            '文章',
            result.posts.map((item) => {
              const p = item.p;
              const tags = p.g.slice(0, 3).join(' / ');
              const snip = snippet(p.x, result.tokens);
              return (
                '<li class="sr-item"><a class="sr-link" href="/' +
                encodeURIComponent(p.s) +
                '/">' +
                highlight(p.t, result.tokens) +
                '</a><p class="sr-meta">' +
                esc(p.d) +
                (p.c && p.c !== '原创' ? ' · ' + esc(p.c) : '') +
                (tags ? ' · ' + highlight(tags, result.tokens) : '') +
                '</p>' +
                (snip ? '<p class="sr-snippet">' + highlight(snip, result.tokens) + '</p>' : '') +
                '</li>'
              );
            }),
          );

          group(
            '写真角色',
            result.chars.map((item) => {
              const c = item.c;
              return (
                '<li class="sr-item"><a class="sr-link" href="/photos/?tag=' +
                encodeURIComponent(c.k) +
                '">' +
                highlight(c.n, result.tokens) +
                '</a><p class="sr-meta">' +
                c.c +
                ' 张 · ' +
                esc(c.y) +
                (c.b ? ' · ' + esc(c.b) : '') +
                '</p>' +
                (c.w ? '<p class="sr-snippet">' + highlight(c.w, result.tokens) + '</p>' : '') +
                '</li>'
              );
            }),
          );

          group(
            '写真年份',
            result.years.map(
              (y) =>
                '<li class="sr-item"><a class="sr-link" href="/photos/?year=' +
                encodeURIComponent(y.y) +
                '">' +
                esc(y.y) +
                ' 年的写真</a><p class="sr-meta">' +
                y.c +
                ' 张照片</p></li>',
            ),
          );

          list.innerHTML = html.join('');
          list.hidden = false;
          const bits = [];
          if (result.posts.length) bits.push(result.posts.length + ' 篇文章');
          if (result.chars.length) bits.push(result.chars.length + ' 位角色');
          if (result.years.length) bits.push(result.years.length + ' 个年份');
          status.textContent = '共 ' + total + ' 条 · ' + bits.join(' · ');
        }

        function run() {
          const q = input.value.trim();
          if (!q) {
            list.hidden = true;
            list.innerHTML = '';
            idle.hidden = false;
            status.textContent = '';
            return;
          }
          if (!index) {
            idle.hidden = true;
            list.hidden = true;
            status.textContent = '正在载入索引…';
            loadIndex();
            return;
          }
          render(search(q));
        }

        function step(delta) {
          const links = list.querySelectorAll('.sr-link');
          if (!links.length) return;
          active = (active + delta + links.length) % links.length;
          links.forEach((a, i) => {
            const row = a.closest('.sr-item');
            if (row) row.classList.toggle('is-active', i === active);
          });
          links[active].scrollIntoView({ block: 'nearest' });
        }

        function isOpen() {
          return !modal.hidden;
        }

        function openSearch() {
          if (isOpen()) return;
          lastFocus = document.activeElement;
          clearTimeout(closeTimer);
          input.value = '';
          modal.hidden = false;
          document.body.classList.add('search-open');
          if (reduceMotion) modal.classList.add('is-open');
          else requestAnimationFrame(() => modal.classList.add('is-open'));
          run();
          input.focus({ preventScroll: true });
          loadIndex();
        }

        function closeSearch() {
          if (!isOpen()) return;
          modal.classList.remove('is-open');
          document.body.classList.remove('search-open');
          const done = () => {
            modal.hidden = true;
          };
          if (reduceMotion) done();
          else {
            clearTimeout(closeTimer);
            closeTimer = setTimeout(done, 160);
          }
          if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
        }

        if (opener) opener.addEventListener('click', openSearch);
        if (closeBtn) closeBtn.addEventListener('click', closeSearch);

        modal.addEventListener('click', (e) => {
          if (panel && !panel.contains(e.target)) closeSearch();
        });

        list.addEventListener('click', (e) => {
          if (e.target.closest('.sr-link')) closeSearch();
        });

        if (chipsBox) {
          chipsBox.addEventListener('click', (e) => {
            const chip = e.target.closest('.chip');
            if (!chip) return;
            input.value = chip.dataset.q || '';
            input.focus();
            run();
          });
        }

        input.addEventListener('input', () => {
          clearTimeout(timer);
          timer = setTimeout(run, 70);
        });

        input.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            step(1);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            step(-1);
          } else if (e.key === 'Enter') {
            const links = list.querySelectorAll('.sr-link');
            const target = links[active] || links[0];
            if (target) {
              e.preventDefault();
              target.click();
            }
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeSearch();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (!isOpen()) {
            const tag = e.target && e.target.tagName;
            const typing =
              tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || (e.target && e.target.isContentEditable);
            if (typing) return;
            if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
              e.preventDefault();
              openSearch();
            } else if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
              e.preventDefault();
              openSearch();
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            closeSearch();
          }
        });
      })();
    </script>

  </body>
</html>
