---
import Base from '../../layouts/Base.astro';
import PostEntries from '../../components/PostEntries.astro';
import { loadPosts, inCategory } from '../../lib/posts';

const all = inCategory(await loadPosts(), '转载');
const posts = all;
const translated = all.filter((p) => p.badge === '譯').length;
const reposted = all.filter((p) => p.badge === '轉').length;
---
<Base title="转载" description="原田莓莓的译文与转载。">
  <header class="page-head">
    <h1>转载</h1>
    <p>
      {posts.length} 篇：译文 {translated} 篇、转载 {reposted} 篇。译文是别人写的、我译过来，转载是原样搬来的；版权都在原作者那儿，有异议请联系我下架。
    </p>
  </header>
  <section class="section">
    <ul class="entry-list">
      <PostEntries posts={posts} />
    </ul>
  </section>
</Base>
