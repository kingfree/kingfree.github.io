---
import birthdays from '../data/birthdays.json';
import gallery from '../data/gallery.json';

// 角色 tag -> 照片列表（生日格子一律用最新拍的那张）
const photosByTag = new Map();
for (const p of gallery.photos) {
  for (const t of p.tags) {
    const list = photosByTag.get(t);
    if (list) list.push(p);
    else photosByTag.set(t, [p]);
  }
}

function pickPhoto(tag) {
  const list = photosByTag.get(tag) || [];
  let latest = null;
  for (const p of list) {
    if (!latest || p.ts > latest.ts) latest = p;
  }
  return latest;
}

const characters = [];
for (const c of birthdays.characters) {
  if (!(c.mon > 0 && c.day > 0)) continue;
  const photo = pickPhoto(c.tag);
  characters.push({
    tag: c.tag,
    name: c.name,
    mon: c.mon,
    day: c.day,
    works: c.works || [],
    photo: photo ? photo.thumb : '',
    count: (photosByTag.get(c.tag) || []).length,
    initial: (c.name || '?').slice(0, 1),
  });
}

const unknown = [];
for (const c of birthdays.unknown) {
  if (c.mon > 0 && c.day > 0) continue;
  unknown.push({ tag: c.tag, name: c.name, work: (c.works && c.works[0]) || '' });
}
---

<div class="bd-dialog" id="bd-dialog" hidden>
  <div class="bd-sheet" role="dialog" aria-modal="true" aria-labelledby="bd-title">
    <header class="bd-head">
      <h2 class="bd-title" id="bd-title">角色生日<span class="bd-title-n">{characters.length}</span></h2>
      <button class="bd-close" id="bd-close" type="button" aria-label="关闭">×</button>
    </header>

    <div class="bd-bar">
      <button class="bd-nav" id="bd-prev" type="button" aria-label="上个月">‹</button>
      <span class="bd-month" id="bd-month" aria-live="polite">—</span>
      <button class="bd-nav" id="bd-next" type="button" aria-label="下个月">›</button>
      <button class="bd-today" id="bd-today" type="button">本月</button>
    </div>

    <div class="bd-week" aria-hidden="true">
      <span>日</span><span>一</span><span>二</span><span>三</span><span>四</span><span>五</span><span>六</span>
    </div>
    <div class="bd-grid" id="bd-grid" aria-label="角色生日月历"></div>
    <p class="bd-count" id="bd-count"></p>

    {unknown.length > 0 && (
      <details class="bd-unknown">
        <summary>生日未知<span class="bd-unknown-n">{unknown.length}</span></summary>
        <ul class="bd-unknown-list">
          {unknown.map((u) => (
            <li>
              <a href={`/photos/?tag=${encodeURIComponent(u.tag)}`} title={u.work || undefined}>{u.name}</a>
            </li>
          ))}
        </ul>
      </details>
    )}
  </div>

  <div class="bd-pop" id="bd-pop" hidden role="dialog" aria-label="同一天的角色">
    <p class="bd-pop-head" id="bd-pop-head"></p>
    <ul class="bd-pop-list" id="bd-pop-list"></ul>
  </div>
</div>

<script is:inline type="application/json" id="bday-data" set:html={JSON.stringify({ characters }).replace(/</g, '\\u003c')}></script>

<script is:inline>
  (() => {
    const dialog = document.getElementById('bd-dialog');
    const sheet = dialog && dialog.querySelector('.bd-sheet');
    const grid = document.getElementById('bd-grid');
    const monthLabel = document.getElementById('bd-month');
    const countLine = document.getElementById('bd-count');
    if (!dialog || !grid || !monthLabel) return;

    const dataNode = document.getElementById('bday-data');
    let data = {};
    try {
      data = JSON.parse((dataNode && dataNode.textContent) || '{}');
    } catch (err) {
      data = {};
    }
    const characters = Array.isArray(data.characters) ? data.characters : [];

    // 按「月-日」归拢，同一天可能有多个角色
    const byDay = new Map();
    for (const c of characters) {
      const key = c.mon * 100 + c.day;
      const list = byDay.get(key);
      if (list) list.push(c);
      else byDay.set(key, [c]);
    }

    const today = new Date();
    let year = today.getFullYear();
    let month = today.getMonth();
    const todayKey = today.getFullYear() * 10000 + (today.getMonth() + 1) * 100 + today.getDate();
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const ESC = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
    const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (ch) => ESC[ch]);

    function tipHtml(people) {
      return people
        .map((c) => {
          const work = c.works && c.works.length ? c.works[0] : '';
          return (
            '<span class="bd-tip-row"><b>' + esc(c.name) + '</b>' +
            (work ? '<em>' + esc(work) + '</em>' : '') +
            '</span>'
          );
        })
        .join('');
    }

    // 同一天有几个人，就把格子等分成几格
    function splitOf(n) {
      if (n <= 1) return [1, 1];
      if (n === 2) return [2, 1];
      if (n === 3) return [3, 1];
      if (n === 4) return [2, 2];
      return [3, Math.ceil(n / 3)];
    }

    // 一个人时直接是链接；多人时整格是按钮，点开浮层再选
    function personHtml(day, c, asLink) {
      const label = month + 1 + ' 月 ' + day + ' 日 · ' + c.name;
      const tag = asLink ? 'a' : 'span';
      const href = asLink ? ' href="/photos/?tag=' + encodeURIComponent(c.tag) + '"' : '';
      const media = c.photo
        ? '<img class="bd-photo" src="' + esc(c.photo) + '" alt="" loading="lazy" decoding="async" />'
        : '';
      return (
        '<' + tag + ' class="bd-person' + (c.photo ? '' : ' no-img') + '"' +
        href +
        ' data-tag="' + esc(c.tag) + '"' +
        ' data-initial="' + esc(c.initial) + '"' +
        ' aria-label="' + esc(label) + ' 的写真">' +
        media +
        '</' + tag + '>'
      );
    }

    function cellHtml(day, people, isToday) {
      const num = '<span class="bd-num">' + day + '</span>';
      if (!people.length) {
        return '<div class="bd-cell' + (isToday ? ' is-today' : '') + '">' + num + '</div>';
      }
      const multi = people.length > 1;
      const names = people.map((c) => c.name).join('、');
      const split = splitOf(people.length);
      const style = ' style="--bd-cols:' + split[0] + ';--bd-rows:' + split[1] + '"';
      const label = month + 1 + ' 月 ' + day + ' 日 · ' + names;
      const attrs = multi
        ? ' role="button" tabindex="0" aria-haspopup="dialog" aria-expanded="false"' +
          ' data-day="' + day + '"' +
          ' aria-label="' + esc(label + '，共 ' + people.length + ' 位角色，点开查看') + '"'
        : ' aria-label="' + esc(label) + '"';
      return (
        '<div class="bd-cell has-photo' + (isToday ? ' is-today' : '') + (multi ? ' is-multi' : '') + '"' +
        attrs + '>' +
        num +
        '<div class="bd-people"' + style + '>' + people.map((c) => personHtml(day, c, !multi)).join('') + '</div>' +
        '<span class="bd-tip">' + tipHtml(people) + '</span>' +
        '</div>'
      );
    }

    // ---- 同一天多个角色：点格子弹出浮层 ----
    const pop = document.getElementById('bd-pop');
    const popHead = document.getElementById('bd-pop-head');
    const popList = document.getElementById('bd-pop-list');
    let popCell = null;

    function popItemHtml(c) {
      const work = c.works && c.works.length ? c.works[0] : '';
      const media = c.photo
        ? '<img class="bd-pop-photo" src="' + esc(c.photo) + '" alt="" loading="lazy" decoding="async" />'
        : '<span class="bd-pop-photo is-initial">' + esc(c.initial) + '</span>';
      return (
        '<li><a class="bd-pop-item" href="/photos/?tag=' + encodeURIComponent(c.tag) + '"' +
        ' data-tag="' + esc(c.tag) + '">' +
        media +
        '<span class="bd-pop-body"><b>' + esc(c.name) + '</b>' +
        (work ? '<em>' + esc(work) + '</em>' : '') +
        '<span class="bd-pop-n">' + (c.count || 0) + ' 张写真</span></span>' +
        '</a></li>'
      );
    }

    // 贴着格子放，靠边时往里收、放不下就翻到上面
    function placePop(cell) {
      if (!pop || pop.hidden) return;
      const rect = cell.getBoundingClientRect();
      const w = pop.offsetWidth;
      const h = pop.offsetHeight;
      const gap = 10;
      const pad = 10;
      let left = rect.left + rect.width / 2 - w / 2;
      left = Math.min(Math.max(pad, left), window.innerWidth - w - pad);
      let top = rect.bottom + gap;
      if (top + h > window.innerHeight - pad) top = rect.top - gap - h;
      if (top < pad) top = pad;
      pop.style.left = Math.round(left) + 'px';
      pop.style.top = Math.round(top) + 'px';
    }

    function openPop(cell) {
      if (!pop || !popList) return;
      const day = Number(cell.dataset.day);
      const people = byDay.get((month + 1) * 100 + day) || [];
      if (people.length < 2) return;
      closePop(false);
      popCell = cell;
      popHead.textContent = month + 1 + ' 月 ' + day + ' 日 · ' + people.length + ' 位角色';
      popList.innerHTML = people.map((c) => popItemHtml(c)).join('');
      pop.hidden = false;
      placePop(cell);
      requestAnimationFrame(() => pop.classList.add('is-open'));
      cell.setAttribute('aria-expanded', 'true');
      const first = popList.querySelector('.bd-pop-item');
      if (first) first.focus({ preventScroll: true });
    }

    function closePop(refocus) {
      if (!pop || pop.hidden) return;
      pop.hidden = true;
      pop.classList.remove('is-open');
      if (popCell) {
        popCell.setAttribute('aria-expanded', 'false');
        if (refocus) popCell.focus({ preventScroll: true });
        popCell = null;
      }
    }

    function render(options) {
      const silent = Boolean(options && options.silent);
      closePop(false);
      const firstWeekday = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      // 固定 6 行：切换月份时弹窗尺寸不变，不会上下抖动
      const rows = 6;
      const total = rows * 7;
      const prevDays = new Date(year, month, 0).getDate();
      const html = [];
      let birthdays = 0;
      for (let i = 0; i < total; i++) {
        const day = i - firstWeekday + 1;
        if (day < 1 || day > daysInMonth) {
          // 前后补位的日子只写个淡淡的日期，撑满固定的 6 行
          const label = day < 1 ? prevDays + day : day - daysInMonth;
          html.push(
            '<div class="bd-cell is-out" aria-hidden="true"><span class="bd-num">' + label + '</span></div>',
          );
          continue;
        }
        const people = byDay.get((month + 1) * 100 + day) || [];
        if (people.length) birthdays += people.length;
        html.push(cellHtml(day, people, year * 10000 + (month + 1) * 100 + day === todayKey));
      }
      monthLabel.textContent = year + ' 年 ' + (month + 1) + ' 月';
      grid.innerHTML = html.join('');
      if (countLine) {
        countLine.textContent = birthdays ? '本月 ' + birthdays + ' 位角色生日' : '本月没有角色生日';
      }
      if (!silent && !reduceMotion) {
        grid.classList.remove('is-in');
        void grid.offsetWidth;
        grid.classList.add('is-in');
      }
      for (const img of grid.querySelectorAll('img.bd-photo')) {
        img.addEventListener(
          'error',
          () => {
            const person = img.closest('.bd-person');
            img.remove();
            if (person) person.classList.add('no-img');
          },
          { once: true },
        );
      }
    }

    function shift(delta) {
      const d = new Date(year, month + delta, 1);
      year = d.getFullYear();
      month = d.getMonth();
      render();
    }

    // ---- 打开 / 关闭 ----
    let lastFocus = null;
    let closeTimer = 0;

    function isOpen() {
      return !dialog.hidden;
    }

    function openDialog() {
      if (isOpen()) return;
      lastFocus = document.activeElement;
      clearTimeout(closeTimer);
      dialog.hidden = false;
      document.body.classList.add('lb-open');
      if (reduceMotion) dialog.classList.add('is-open');
      else requestAnimationFrame(() => dialog.classList.add('is-open'));
      const closeBtn = document.getElementById('bd-close');
      if (closeBtn) closeBtn.focus({ preventScroll: true });
    }

    function closeDialog() {
      if (!isOpen()) return;
      closePop(false);
      dialog.classList.remove('is-open');
      document.body.classList.remove('lb-open');
      const done = () => {
        dialog.hidden = true;
        if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
      };
      if (reduceMotion) done();
      else {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(done, 200);
      }
    }

    for (const btn of document.querySelectorAll('[data-bd-open]')) {
      btn.addEventListener('click', openDialog);
    }
    const closeBtn = document.getElementById('bd-close');
    if (closeBtn) closeBtn.addEventListener('click', closeDialog);
    if (sheet) {
      dialog.addEventListener('click', (e) => {
        if (pop && pop.contains(e.target)) return;
        if (!sheet.contains(e.target)) closeDialog();
      });
    }

    // 点日历别的格子 / 空白处关掉浮层
    document.addEventListener('click', (e) => {
      if (!pop || pop.hidden) return;
      const target = e.target;
      if (pop.contains(target)) return;
      if (target.closest && target.closest('.bd-cell.is-multi')) return;
      closePop(false);
    });

    // 一天多个角色：点格子开浮层；只有一个角色：直接筛这个角色
    grid.addEventListener('click', (e) => {
      const multi = e.target.closest('.bd-cell.is-multi');
      if (multi) {
        e.preventDefault();
        if (popCell === multi) closePop(false);
        else openPop(multi);
        return;
      }
      const cell = e.target.closest('a.bd-person');
      if (!cell) return;
      const tag = cell.dataset.tag || '';
      if (typeof window.gallerySetTag === 'function') {
        e.preventDefault();
        window.gallerySetTag(tag);
        closeDialog();
      }
    });

    grid.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const multi = e.target.closest && e.target.closest('.bd-cell.is-multi');
      if (!multi) return;
      e.preventDefault();
      openPop(multi);
    });

    if (pop) {
      pop.addEventListener('click', (e) => {
        const item = e.target.closest('.bd-pop-item');
        if (!item) return;
        const tag = item.dataset.tag || '';
        if (typeof window.gallerySetTag === 'function') {
          e.preventDefault();
          closePop(false);
          window.gallerySetTag(tag);
          closeDialog();
        }
      });
    }

    const prev = document.getElementById('bd-prev');
    const next = document.getElementById('bd-next');
    const back = document.getElementById('bd-today');
    if (prev) prev.addEventListener('click', () => shift(-1));
    if (next) next.addEventListener('click', () => shift(1));
    if (back)
      back.addEventListener('click', () => {
        const t = new Date();
        year = t.getFullYear();
        month = t.getMonth();
        render();
      });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        if (pop && !pop.hidden) closePop(true);
        else closeDialog();
        return;
      }
      const tag = e.target && e.target.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      // 浮层打开时上下键在角色之间走，左右键不再翻月份
      if (pop && !pop.hidden) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          const items = Array.prototype.slice.call(popList.querySelectorAll('.bd-pop-item'));
          if (!items.length) return;
          e.preventDefault();
          const at = items.indexOf(document.activeElement);
          const next = e.key === 'ArrowDown' ? (at + 1) % items.length : (at - 1 + items.length) % items.length;
          if (items[next]) items[next].focus({ preventScroll: true });
        }
        return;
      }
      if (e.key === 'ArrowLeft') shift(-1);
      else if (e.key === 'ArrowRight') shift(1);
    });

    window.addEventListener('resize', () => {
      if (pop && !pop.hidden && popCell) placePop(popCell);
    });

    render({ silent: true });
  })();
</script>

<style is:global>
  /* ---------- 生日月历（相册页内弹出） ---------- */

  .bd-dialog {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 1.25rem;
    background: color-mix(in srgb, #0b0908 58%, transparent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .bd-dialog[hidden] {
    display: none;
  }

  .bd-dialog.is-open {
    opacity: 1;
  }

  .bd-sheet {
    /* 宽高都随视口收紧：6 行方格始终放得下，弹窗高度不变 */
    width: min(47rem, 100%);
    /* 减去弹窗内除日期格以外的高度，保证 6 行方格整块放得下、不出现内部滚动 */
    width: clamp(18rem, min(47rem, calc((100dvh - 18.5rem) * 7 / 6)), 100%);
    max-width: 100%;
    max-height: calc(100vh - 2.5rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 1rem 1.25rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.28);
    transform: translateY(8px) scale(0.995);
    transition: transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .bd-dialog.is-open .bd-sheet {
    transform: none;
  }

  .bd-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .bd-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .bd-title-n {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--faint);
  }

  .bd-close {
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .bd-close:hover,
  .bd-close:focus-visible {
    border-color: var(--faint);
    color: var(--text);
  }

  .bd-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.1rem 0 0.7rem;
  }

  .bd-month {
    min-width: 8.5em;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .bd-nav {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--bg);
    color: var(--muted);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .bd-nav:hover,
  .bd-nav:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .bd-today {
    margin-left: 0.35rem;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1.6;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .bd-today:hover,
  .bd-today:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .bd-week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    padding-bottom: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--faint);
    text-align: center;
    text-indent: 0.14em;
  }

  .bd-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    /* 固定 6 行：5 周、6 周的月份格子一样高 */
    grid-template-rows: repeat(6, minmax(0, 1fr));
    aspect-ratio: 7 / 6;
    gap: 1px;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--border);
    overflow: hidden;
  }

  .bd-grid.is-in {
    animation: bd-fade 0.32s ease both;
  }

  @keyframes bd-fade {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .bd-cell {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
  }

  /* 同一天多个角色：格子内等分，各放自己的照片 */
  .bd-people {
    position: absolute;
    z-index: 1;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--bd-cols, 1), minmax(0, 1fr));
    grid-template-rows: repeat(var(--bd-rows, 1), minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
  }

  .bd-person {
    position: relative;
    display: block;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--bg-soft);
    color: inherit;
    text-decoration: none;
  }

  .bd-person:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: -1px;
  }

  .bd-cell.is-out {
    background: color-mix(in srgb, var(--bg-soft) 55%, var(--bg));
  }

  .bd-cell.is-out .bd-num {
    color: color-mix(in srgb, var(--faint) 45%, transparent);
  }

  .bd-cell.has-photo {
    background: var(--bg-soft);
