---
import Base from '../../layouts/Base.astro';
import PostEntries from '../../components/PostEntries.astro';
import { loadPosts, inCategory } from '../../lib/posts';

const posts = inCategory(await loadPosts(), '转');
---
<Base title="转载" description="原田莓莓转载的文章。">
  <header class="page-head">
    <h1>转载</h1>
    <p>{posts.length ? posts.length + ' 篇。' : '还没有转载的文章。'}</p>
  </header>
  {
    posts.length > 0 && (
      <section class="section">
        <ul class="entry-list">
          <PostEntries posts={posts} />
        </ul>
      </section>
    )
  }
</Base>
