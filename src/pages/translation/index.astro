---
import Base from '../../layouts/Base.astro';
import PostEntries from '../../components/PostEntries.astro';
import { loadPosts, inCategory } from '../../lib/posts';

const posts = inCategory(await loadPosts(), '译');
---
<Base title="译文" description="原田莓莓的译作：摄影、技术与其他。">
  <header class="page-head">
    <h1>译文</h1>
    <p>
      {posts.length} 篇。都是别人写的，我译过来；版权归原作者，原文通常已不可达，文末一般标了出处。
      有异议请联系我下架。
    </p>
  </header>
  <section class="section">
    <ul class="entry-list">
      <PostEntries posts={posts} />
    </ul>
  </section>
</Base>
