---
import Base from '../layouts/Base.astro';
import PostEntries from '../components/PostEntries.astro';
import gallery from '../data/gallery.json';
import birthdays from '../data/birthdays.json';
import { loadPosts, originals, inCategory } from '../lib/posts';

const all = await loadPosts();
const posts = originals(all);
const latest = posts.slice(0, 6);
const reposted = inCategory(all, '转载');
const recentReposts = reposted.slice(0, 4);
const reading = inCategory(all, '读书').length;

// 每个角色最新的一张照片（跟生日弹层一致）
const latestPhoto = new Map();
for (const photo of gallery.photos) {
  for (const tag of photo.tags) {
    const cur = latestPhoto.get(tag);
    if (!cur || photo.ts > cur.ts) latestPhoto.set(tag, photo);
  }
}

// 今天生日；没有就按「还有几天」排最近的几位
const now = new Date();
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
const daysUntil = (mon, day) => {
  let next = new Date(today.getFullYear(), mon - 1, day);
  if (next < today) next = new Date(today.getFullYear() + 1, mon - 1, day);
  return Math.round((next.getTime() - today.getTime()) / 86400000);
};
const dated = birthdays.characters
  .filter((c) => c.mon > 0 && c.day > 0)
  .map((c) => ({ name: c.name, tag: c.tag, mon: c.mon, day: c.day, inDays: daysUntil(c.mon, c.day) }))
  .sort((a, b) => a.inDays - b.inDays);
const todayList = dated.filter((c) => c.inDays === 0);
const birthdayLabel = todayList.length ? '今天生日' : '最近的生日';
// 今天有谁就摆谁，不够 8 位就用最近要过生日的补齐
const birthdayList = [...todayList, ...dated.filter((c) => c.inDays > 0)].slice(0, 8);
---

<Base description="原田莓莓（Meimei / 王者自由）的个人站：Kigurumi、Rust 与前端、读书笔记。">
  <section class="hero">
    <p class="eyebrow">Meimei · kingfree</p>
    <h1>原田莓莓</h1>
    <p class="lead">
      做 <strong>Kigurumi 头壳</strong>，偶尔（让 AI 大人代劳）写点 <strong>Rust</strong> 和前端，
      读书。
    </p>
    <blockquote class="quote">
      原田每每，舍其旧而新是谋。
      <cite>——《左传 · 僖公二十八年》</cite>
    </blockquote>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>{birthdayLabel}</h2>
      <a href="/photos/">写真 {gallery.count} 张 →</a>
    </div>
    <ul class="birthday-strip">
      {birthdayList.map((c) => {
        const photo = latestPhoto.get(c.tag);
        return (
          <li class="birthday-card">
            <a href={'/photos/?tag=' + encodeURIComponent(c.tag)} title={c.name + ' 的写真'}>
              {photo ? (
                <img
                  src={photo.thumb}
                  alt={c.name + " 的写真"}
                  loading="lazy"
                  decoding="async"
                  width={photo.tw}
                  height={photo.th}
                />
              ) : (
                <span class="birthday-initial" aria-hidden="true">{c.name.slice(0, 1)}</span>
              )}
              <span class="birthday-name">{c.name}</span>
              <span class="birthday-when" title={c.mon + " 月 " + c.day + " 日"}>
                {String(c.mon).padStart(2, "0") + "-" + String(c.day).padStart(2, "0")}
                <span class="d">{c.inDays === 0 ? "今天" : c.inDays + " 天后"}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近写的</h2>
      <a href="/posts/">全部 {posts.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={latest} showYear={false} />
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近转载</h2>
      <a href="/repost/">全部 {reposted.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={recentReposts} showYear={false} />
    </ul>
    <p class="note">
      译文也算转载，另有 <a href="/reading/">读书笔记 {reading} 篇</a>。
    </p>
  </section>
</Base>
