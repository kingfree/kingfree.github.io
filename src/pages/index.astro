---
import Base from '../layouts/Base.astro';
import PostEntries from '../components/PostEntries.astro';
import { loadPosts } from '../lib/posts';

const posts = await loadPosts();
const latest = posts.slice(0, 6);
---
<Base description="原田莓莓（Meimei / 王者自由）的个人站：Kigurumi、Rust 与前端、读书笔记。">
  <section class="hero">
    <p class="eyebrow">Meimei · kingfree</p>
    <h1>原田莓莓</h1>
    <p class="lead">
      舍其旧而新是谋。做 <strong>Kigurumi</strong>，偶尔写点 <strong>Rust</strong> 和前端，
      读书、拍照、翻译一些东西。
    </p>
    <blockquote class="quote">
      原田每每，舍其旧而新是谋。
      <cite>《左传 · 僖公二十八年》——名字与站名的来处</cite>
    </blockquote>
    <ul class="links">
      <li><a href="https://github.com/kingfree" rel="me noopener">GitHub</a></li>
      <li><a href="https://weibo.com/kingfree" rel="me noopener">微博</a></li>
      <li><a href="https://x.com/meimeikaze" rel="me noopener">Twitter</a></li>
      <li><a href="/about/">关于</a></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近写的</h2>
      <a href="/posts/">全部 {posts.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={latest} showYear={false} />
    </ul>
  </section>
</Base>
