---
import Base from '../layouts/Base.astro';
import PostEntries from '../components/PostEntries.astro';
import { loadPosts, originals, inCategory } from '../lib/posts';

const all = await loadPosts();
const posts = originals(all);
const latest = posts.slice(0, 6);
const reposted = inCategory(all, '转载');
const recentReposts = reposted.slice(0, 4);
const reading = inCategory(all, '读书').length;
---

<Base description="原田莓莓（Meimei / 王者自由）的个人站：Kigurumi、Rust 与前端、读书笔记。">
  <section class="hero">
    <p class="eyebrow">Meimei · kingfree</p>
    <h1>原田莓莓</h1>
    <p class="lead">
      做 <strong>Kigurumi 头壳</strong>，偶尔（让 AI 大人代劳）写点 <strong>Rust</strong> 和前端，
      读书。
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近写的</h2>
      <a href="/posts/">全部 {posts.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={latest} showYear={false} />
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近转载</h2>
      <a href="/repost/">全部 {reposted.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={recentReposts} showYear={false} />
    </ul>
    <p class="note">
      译文也算转载，另有 <a href="/reading/">读书笔记 {reading} 篇</a>。
    </p>
  </section>
</Base>
