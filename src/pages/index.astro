---
import Base from '../layouts/Base.astro';
import PostEntries from '../components/PostEntries.astro';
import { loadPosts, originals, inCategory } from '../lib/posts';

const all = await loadPosts();
const posts = originals(all);
const latest = posts.slice(0, 6);
const translated = inCategory(all, '译').length;
---

<Base description="原田莓莓（Meimei / 王者自由）的个人站：Kigurumi、Rust 与前端、读书笔记。">
  <section class="hero">
    <p class="eyebrow">Meimei · kingfree</p>
    <h1>原田莓莓</h1>
    <p class="lead">
      做 <strong>Kigurumi 头壳</strong>，偶尔（让 AI 大人代劳）写点 <strong>Rust</strong> 和前端，
      读书。
    </p>
    <blockquote class="quote">
      原田每每，舍其旧而新是谋。
      <cite>——《左传 · 僖公二十八年》</cite>
    </blockquote>
    <ul class="links">
      <li><a href="https://github.com/kingfree" rel="me noopener">GitHub</a></li>
      <li><a href="https://x.com/meimeikaze" rel="me noopener">X</a></li>
      <li><a href="https://meis.moe" rel="noopener">莓萌® | 虹野物联</a></li>
      <li><a href="https://pinhaotou.cn" rel="noopener">拼好头™</a></li>
      <li><a href="/about/">关于</a></li>
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最近写的</h2>
      <a href="/posts/">全部 {posts.length} 篇 →</a>
    </div>
    <ul class="entry-list">
      <PostEntries posts={latest} showYear={false} />
    </ul>
    <p class="note">
      另有 <a href="/translation/">译文</a> {translated} 篇，大多是日文摄影笔记，原文多已从网络消失。
    </p>
  </section>
</Base>
