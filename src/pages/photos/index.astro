---
import Base from '../../layouts/Base.astro';
import BirthdayCalendar from '../../components/BirthdayCalendar.astro';
import gallery from '../../data/gallery.json';
import birthdays from '../../data/birthdays.json';

const { photos, tags, years, count } = gallery;

// 角色 tag 按生日排序；没有生日的 tag 排后面按数量
const birthdayOf = new Map(birthdays.characters.map((c) => [c.tag, c.mon * 100 + c.day]));
const ordered = tags.slice().sort((a, b) => {
  const ba = birthdayOf.get(a.name);
  const bb = birthdayOf.get(b.name);
  if (ba && bb) return ba - bb;
  if (ba) return -1;
  if (bb) return 1;
  return b.count - a.count || a.name.localeCompare(b.name, 'zh');
});
const charsWithBirthday = ordered.filter((t) => birthdayOf.has(t.name));
const others = ordered.filter((t) => !birthdayOf.has(t.name)).slice(0, 8);
const topTags = [...charsWithBirthday, ...others];
const span = years.length ? years[0] + '—' + years[years.length - 1] : '';
---

<Base wide title="写真" description="原田莓莓的着ぐるみ写真：按拍摄时间排列，可按角色与年份筛选。">
  <header class="gallery-head">
    <div class="gallery-headline">
      <h1>写真</h1>
      <p class="gallery-meta" id="gallery-meta">{count} 张<span>{span && ' · ' + span}</span></p>
    </div>
    <div class="gallery-actions">
      <button class="ghost-btn" type="button" data-bd-open>生日</button>
      <button class="ghost-btn" type="button" id="filter-btn" aria-expanded="false" aria-controls="gallery-filters">
        筛选
      </button>
    </div>
  </header>

  <div class="gallery-filters" id="gallery-filters" hidden>
    <ul class="gallery-chips" id="tag-chips">
      <li><button class="chip is-on" type="button" data-tag="">全部</button></li>
      {topTags.map((t) => (
        <li>
          <button class="chip" type="button" data-tag={t.name}>
            {t.name}<span class="n">{t.count}</span>
          </button>
        </li>
      ))}
    </ul>
    <div class="gallery-tools">
      <select id="year-select" aria-label="按年份筛选">
        <option value="all">全部年份</option>
        {years.map((y) => <option value={y}>{y}</option>)}
      </select>
      <button class="chip" type="button" id="sort-btn" data-order="desc">时间 ↓</button>
    </div>
  </div>

  <div class="gallery" id="gallery">
    {photos.map((p, i) => (
      <figure
        class="shot"
        data-tags={p.tags.join(' ')}
        data-year={p.year}
        data-ts={p.ts}
        data-tw={p.tw}
        data-th={p.th}
      >
        <button
          class="shot-btn"
          type="button"
          data-full={p.src}
          data-caption={(p.date + (p.tags.length ? ' · ' + p.tags.join(' / ') : '')).replace(/"/g, '&quot;')}
          aria-label={'查看 ' + p.date + ' 的照片'}
        >
          <img
            class="shot-img"
            src={p.thumb}
            srcset={p.thumb + ' ' + p.tw + 'w, ' + p.src + ' ' + p.w + 'w'}
            sizes="(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 20vw"
            width={p.tw}
            height={p.th}
            loading={i < 6 ? 'eager' : 'lazy'}
            decoding="async"
            alt={p.date + ' 的写真'}
          />
          <span class="shot-meta">
            <time datetime={p.date}>{p.date}</time>
            {p.tags.length > 0 && <span>{p.tags[0]}</span>}
          </span>
        </button>
      </figure>
    ))}
  </div>

  <p class="gallery-empty" id="gallery-empty" hidden>没有符合条件的照片。</p>

  <BirthdayCalendar />

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="照片查看">
    <button class="lb-btn lb-close" type="button" data-act="close" aria-label="关闭">✕</button>
    <button class="lb-btn lb-prev" type="button" data-act="prev" aria-label="上一张">‹</button>
    <button class="lb-btn lb-next" type="button" data-act="next" aria-label="下一张">›</button>
    <figure class="lb-figure">
      <img id="lb-img" alt="" />
      <figcaption id="lb-cap"></figcaption>
    </figure>
  </div>

  <script is:inline>
    (() => {
      const grid = document.getElementById('gallery');
      const meta = document.getElementById('gallery-meta');
      const empty = document.getElementById('gallery-empty');
      const yearSelect = document.getElementById('year-select');
      const sortBtn = document.getElementById('sort-btn');
      const filterBtn = document.getElementById('filter-btn');
      const filters = document.getElementById('gallery-filters');
      const chips = Array.from(document.querySelectorAll('#tag-chips .chip'));
      const lightbox = document.getElementById('lightbox');
      const lbImg = document.getElementById('lb-img');
      const lbCap = document.getElementById('lb-cap');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const GAP = 10;
      const MIN_COL = 200;

      const total = grid.querySelectorAll('.shot').length;
      let items = Array.from(grid.querySelectorAll('.shot'));
      let tag = '';
      let year = 'all';
      let order = 'desc';
      let visible = [];
      let cursor = -1;

      function syncUrl() {
        const params = new URLSearchParams(location.search);
        if (tag) params.set('tag', tag);
        else params.delete('tag');
        if (year !== 'all') params.set('year', year);
        else params.delete('year');
        const q = params.toString();
        try {
          history.replaceState(null, '', location.pathname + (q ? '?' + q : '') + location.hash);
        } catch {}
      }

      function sortItems() {
        items.sort((a, b) => {
          const d = Number(a.dataset.ts) - Number(b.dataset.ts);
          return order === 'asc' ? d : -d;
        });
        for (const el of items) grid.appendChild(el);
      }

      // 瀑布流：按图片宽高比算高度，往最短的列放
      function layout() {
        const width = grid.clientWidth;
        if (!width) return;
        const cols = width < 560 ? 2 : Math.max(2, Math.floor((width + GAP) / (MIN_COL + GAP)));
        const colW = (width - GAP * (cols - 1)) / cols;
        const heights = new Array(cols).fill(0);

        for (const el of visible) {
          el.style.width = colW + 'px';
          const tw = Number(el.dataset.tw) || 3;
          const th = Number(el.dataset.th) || 4;
          const imgH = (colW * th) / tw;
          const col = heights.indexOf(Math.min(...heights));
          el.style.transform = 'translate(' + (col * (colW + GAP)) + 'px, ' + heights[col] + 'px)';
          heights[col] += imgH + GAP;
        }
        grid.style.height = Math.max(0, ...heights) + 'px';
      }

      function watchImages() {
        for (const img of grid.querySelectorAll('img:not([data-watched])')) {
          img.dataset.watched = '1';
          const done = () => img.classList.add('is-loaded');
          if (img.complete && img.naturalWidth) done();
          else img.addEventListener('load', done, { once: true });
        }
      }

      function reveal(list) {
        if (reduceMotion) {
          for (const el of list) el.classList.add('is-in');
          return;
        }
        list.forEach((el, i) => {
          el.style.transitionDelay = Math.min(i * 10, 200) + 'ms';
          el.classList.add('is-in');
        });
      }

      function setMeta() {
        filterBtn.classList.toggle('has-filter', Boolean(tag) || year !== 'all');
        if (!meta) return;
        const bits = [visible.length + ' 张'];
        if (tag) bits.push(tag);
        if (year !== 'all') bits.push(year);
        if (visible.length !== total) bits.push('共 ' + total + ' 张');
        meta.textContent = bits.join(' · ');
      }

      function apply(animate) {
        visible = [];
        for (const el of items) {
          const ok =
            (!tag || (' ' + el.dataset.tags + ' ').indexOf(' ' + tag + ' ') >= 0) &&
            (year === 'all' || el.dataset.year === year);
          el.hidden = !ok;
          if (ok) visible.push(el);
        }
        setMeta();
        empty.hidden = visible.length !== 0;
        layout();
        watchImages();
        if (animate) reveal(visible);
        if (!lightbox.hidden) {
          if (visible.length) open(0);
          else close();
        }
      }

      let closeTimer = 0;

      function open(i, dir) {
        if (!visible.length) return;
        cursor = (i + visible.length) % visible.length;
        const btn = visible[cursor].querySelector('.shot-btn');
        const src = btn.dataset.full;
        const direction = dir || 0;

        lbImg.alt = btn.getAttribute('aria-label') || '';
        lbCap.textContent = btn.dataset.caption || '';

        clearTimeout(closeTimer);
        if (lightbox.hidden) {
          lightbox.hidden = false;
          document.body.classList.add('lb-open');
          if (!reduceMotion) {
            requestAnimationFrame(() => lightbox.classList.add('is-open'));
          } else {
            lightbox.classList.add('is-open');
          }
        }

        const revealImg = () => {
          if (reduceMotion) {
            lbImg.classList.add('is-in');
            return;
          }
          lbImg.style.setProperty('--dir', String(direction || 1));
          lbImg.classList.remove('is-in');
          void lbImg.offsetWidth;
          requestAnimationFrame(() => lbImg.classList.add('is-in'));
        };

        if (reduceMotion) {
          lbImg.src = src;
          revealImg();
        } else if (direction === 0 && lbImg.getAttribute('src')) {
          lbImg.classList.remove('is-in');
          lbImg.src = src;
          if (lbImg.complete) requestAnimationFrame(revealImg);
          else lbImg.addEventListener('load', revealImg, { once: true });
        } else {
          lbImg.classList.remove('is-in');
          lbImg.src = src;
          if (lbImg.complete && lbImg.naturalWidth) requestAnimationFrame(revealImg);
          else lbImg.addEventListener('load', revealImg, { once: true });
        }

        const next = visible[(cursor + 1) % visible.length].querySelector('.shot-btn');
        new Image().src = next.dataset.full;
      }

      function close() {
        if (lightbox.hidden) return;
        document.body.classList.remove('lb-open');
        if (reduceMotion) {
          lightbox.hidden = true;
          lightbox.classList.remove('is-open');
          lbImg.removeAttribute('src');
          return;
        }
        lightbox.classList.remove('is-open');
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          lightbox.hidden = true;
          lbImg.removeAttribute('src');
          lbImg.classList.remove('is-in');
        }, 220);
      }

      function step(d) {
        if (visible.length) open(cursor + d, d);
      }

      function setTag(next, options) {
        tag = next || '';
        const active = chips.find((c) => c.dataset.tag === tag);
        chips.forEach((c) => c.classList.toggle('is-on', c === active));
        if (options && options.openFilters) setFilters(true);
        syncUrl();
        apply(true);
      }

      function setFilters(open) {
        filters.hidden = !open;
        filterBtn.setAttribute('aria-expanded', String(open));
        filterBtn.classList.toggle('is-on', open);
      }

      // 生日弹窗里的日期格直接调这个，不刷新页面
      window.gallerySetTag = (next) => setTag(next, { openFilters: false });

      chips.forEach((chip) => chip.addEventListener('click', () => setTag(chip.dataset.tag)));
      filterBtn.addEventListener('click', () => setFilters(filters.hidden));
      yearSelect.addEventListener('change', () => {
        year = yearSelect.value;
        syncUrl();
        apply(true);
      });
      sortBtn.addEventListener('click', () => {
        order = order === 'asc' ? 'desc' : 'asc';
        sortBtn.dataset.order = order;
        sortBtn.textContent = order === 'asc' ? '时间 ↑' : '时间 ↓';
        sortItems();
        apply(false);
        reveal(visible);
      });

      grid.addEventListener('click', (e) => {
        const btn = e.target.closest('.shot-btn');
        if (!btn) return;
        open(visible.indexOf(btn.closest('.shot')));
      });

      lightbox.addEventListener('click', (e) => {
        const act = e.target.closest('[data-act]');
        if (act) {
          const a = act.dataset.act;
          if (a === 'close') close();
          else step(a === 'next' ? 1 : -1);
          return;
        }
        if (e.target === lightbox) close();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
        } else if (e.key === 'ArrowRight' || e.key === 'PageDown') {
          e.preventDefault();
          step(1);
        } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
          e.preventDefault();
          step(-1);
        }
      });

      let touchX = null;
      lightbox.addEventListener('pointerdown', (e) => {
        touchX = e.clientX;
      });
      lightbox.addEventListener('pointerup', (e) => {
        if (touchX === null) return;
        const dx = e.clientX - touchX;
        touchX = null;
        if (Math.abs(dx) > 60) step(dx < 0 ? 1 : -1);
      });

      let resizeTimer = 0;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(layout, 120);
      });

      const params = new URLSearchParams(location.search);
      const initialTag = params.get('tag');
      if (initialTag) tag = initialTag;
      const initialYear = params.get('year');
      if (initialYear && [...yearSelect.options].some((o) => o.value === initialYear)) year = initialYear;
      yearSelect.value = year;
      const activeChip = chips.find((c) => c.dataset.tag === tag);
      chips.forEach((c) => c.classList.toggle('is-on', c === activeChip));
      if (initialTag || initialYear) setFilters(true);

      sortItems();
      apply(false);
      reveal(visible);
      layout();
      // 字体加载 / 图片尺寸变化后再校一次
      window.addEventListener('load', layout);
      setTimeout(layout, 400);
    })();
  </script>
</Base>
